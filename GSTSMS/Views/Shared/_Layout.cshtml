    <style>
        :root {
            --cocoa: #381E1F;
            --mint: #A0E7E5;
            --cream: #FDF6EC;
            --soft-gradient: linear-gradient(135deg, #A0E7E5, #FDF6EC);
            --navbar-gradient: linear-gradient(to right, #A0E7E5, #C3D8FF);
            --footer-color: #A0E7E5;
        }

        .sidebar-menu .nav-link {
            background-color: transparent !important;
            color: #000 !important;
        }

            .sidebar-menu .nav-link:hover,
            .sidebar-menu .active > a {
                background-color: #EFE6DD !important;
                color: black !important;
            }

        .main-sidebar {
            background: var(--soft-gradient) !important;
        }

        .main-navbar {
            background: var(--navbar-gradient) !important;
            color: #000;
        }

        .main-footer {
            background-color: var(--footer-color);
            color: #381E1F;
        }

            .main-footer a {
                color: #381E1F;
                font-weight: bold;
            }
    </style>

    <style>
        /* Layout container */
        .wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar styling */
        .sidebar {
            width: 250px; /* Or however wide your sidebar is */
            background-color: #e0f7fa;
            flex-shrink: 0;
            position: relative;
            z-index: 10;
        }

        Main content area
        .main-content {
            flex-grow: 1;
            padding: 20px;
            overflow-x: auto;
            background-color: #f8f9fa;
        }

        /* Table styling */
        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

            table th, table td {
                padding: 12px 16px;
                border: 1px solid #dee2e6;
                text-align: left;
                white-space: nowrap;
            }
    </style>
</head>

